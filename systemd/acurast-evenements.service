[Unit]
Description=Journal des événements Acurast (scan des blocs)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@DOSSIER@
ExecStart=@DOSSIER@/.venv/bin/python -u @DOSSIER@/acurast_evenements.py
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
